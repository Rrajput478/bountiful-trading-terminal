# ---------------------------------------------------------------------------
# Bountiful Trading Terminal - backend environment
#
# Copy to `.env` and fill in values. NEVER commit `.env` (it is gitignored).
#
# PAPER TRADING IS THE DEFAULT AND REQUIRES NO CREDENTIALS AT ALL.
# Leaving every broker block empty is a valid, fully working setup.
#
# Setting broker credentials does NOT enable live trading. Live adapters still
# refuse to trade until their REST integration is implemented, so you cannot
# accidentally place a real-money order by only filling these in.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# How often the paper market ticks and positions are evaluated for TP/SL.
TICK_INTERVAL_MS=1000

# --- CoinDCX (crypto) -------------------------------------------------------
# Values: [REDACTED] - fill on the backend host only.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# --- Upstox (Indian equities / F&O) -----------------------------------------
# Values: [REDACTED] - fill on the backend host only.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REFRESH_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# --- Delta Exchange (crypto derivatives) ------------------------------------
# Values: [REDACTED] - fill on the backend host only.
DELTA_API_KEY=
DELTA_API_SECRET=